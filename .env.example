# Modèle de configuration ISMaiLa — copier en `.env` et renseigner les valeurs.
# Le fichier `.env` est ignoré par Git : aucun secret ne doit être committé.
# Sur Streamlit Cloud, ces mêmes clés se déclarent dans « Secrets » (st.secrets).

# ── Base de données (obligatoire) ──────────────────────────────────────
MONGO_URI=mongodb+srv://<utilisateur>:<motdepasse>@<cluster>.mongodb.net/
DB_NAME=ismaila_db

# ── Plateforme ─────────────────────────────────────────────────────────
# URL réelle de l'app déployée — sert de lien dans les emails.
PLATFORM_URL=https://ismaila.streamlit.app

# ── Email / SMTP (RG-03) ───────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=                 # mot de passe d'application, jamais le mot de passe du compte
SMTP_FROM=                 # vide → identique à SMTP_USER (voir README, § Délivrabilité)
SMTP_FROM_NAME=ISMaiLa
SMTP_REPLY_TO=             # boîte ISM qui recevra les réponses
SMTP_SSL=false             # true → SSL implicite sur le port 465

# ── NLP / recherche sémantique ─────────────────────────────────────────
# Changer le modèle impose de régénérer tous les embeddings.
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
VECTOR_INDEX_NAME=autoembed_index
NLP_THRESHOLD=0.75         # seuil RG-01 : en dessous → escalade vers un expert

# ── LLM local souverain (Ollama) ───────────────────────────────────────
# Optionnel : sans Ollama installé, les fonctions LLM se désactivent d'elles-mêmes.
# Installation : https://ollama.com puis `ollama pull mistral:7b-instruct-q4_0`
# ⚠️ Ollama ne tourne pas sur Streamlit Cloud (~4 Go de modèle en mémoire) :
#    réservé au back-office tant que l'hébergement n'est pas tranché.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=mistral:7b-instruct-q4_0
OLLAMA_TIMEOUT=120        # secondes ; le 1er appel charge le modèle et est lent

# ── Salesforce (RG-06) ─────────────────────────────────────────────────
SF_WEBHOOK_URL=            # webhook Make/Zapier ; vide → synchro désactivée
SF_TIMEOUT=5
